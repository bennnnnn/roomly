{
  "_comment": "Roomly project settings for Claude Code. MCP servers are in .mcp.json (standard location). See CLAUDE.md §4 for MCP-first policy. AUTONOMOUS MODE: broad allow-lists so you aren't prompted for routine operations. Guard hooks still block truly dangerous commands.",

  "enableAllProjectMcpServers": true,

  "hooks": {
    "SessionStart": [
      {
        "command": ".claude/hooks/session-start.sh"
      }
    ],
    "PreToolUse": [
      {
        "command": ".claude/hooks/guard-shell.sh",
        "matcher": "Bash"
      },
      {
        "command": ".claude/hooks/audit-mcp.sh",
        "matcher": ""
      }
    ],
    "PostToolUse": [
      {
        "command": ".claude/hooks/check-file-size.sh",
        "matcher": "Edit|Write"
      }
    ]
  },

