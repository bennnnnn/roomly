{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": ".cursor/hooks/session-start.sh"
      }
    ],
    "beforeShellExecution": [
      {
        "command": ".cursor/hooks/guard-shell.sh",
        "failClosed": true
      }
    ],
    "afterFileEdit": [
      {
        "command": ".cursor/hooks/check-file-size.sh"
      }
    ],
    "beforeMCPExecution": [
      {
        "command": ".cursor/hooks/audit-mcp.sh"
      }
    ]
  }
}
