# Roomly pnpm install policy.
#
# Hoist Expo / React Native package families to the top of node_modules so
# Metro's resolver and React Native autolinking can find them. Everything
# else stays inside pnpm's strict isolated tree.
#
# See Expo monorepo guide: https://docs.expo.dev/guides/monorepos/
public-hoist-pattern[]=*expo*
public-hoist-pattern[]=*react-native*
public-hoist-pattern[]=@react-native/*
public-hoist-pattern[]=metro*
public-hoist-pattern[]=jest-expo

# Be strict about resolution: don't auto-install peer deps quietly.
auto-install-peers=false
strict-peer-dependencies=false
