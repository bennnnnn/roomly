# Roomly admin — copy to .env.local (never commit secrets).
# Server-only vars must NOT use NEXT_PUBLIC_ prefix.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Service role: server components / Route Handlers only (Slice 7).
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx
