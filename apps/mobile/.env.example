# Roomly mobile public env vars. Copy to .env.local for local development.
#
# Only EXPO_PUBLIC_* vars are inlined into the shipped bundle by Expo.
# Server-only secrets live in Edge Function env vars / EAS secrets — see
# ADR-0009 for the full secret-boundary map.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-from-supabase-dashboard

# Optional observability (logger no-ops gracefully when these are absent).
# EXPO_PUBLIC_SENTRY_DSN=https://xxxxx@oXXXXXX.ingest.sentry.io/XXXXXX
# EXPO_PUBLIC_POSTHOG_API_KEY=phc_XXXXXXXXXXXXXXXXXXXX
# EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
